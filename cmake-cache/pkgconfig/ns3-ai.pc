exec_prefix="/usr/local/bin"
libdir="/usr/local/lib"
includedir="/usr/local/include"

Name: ns3-ai
Description: 
URL: 
Version: 3.46.1
Requires:  ns3-core
Requires.private: 
Cflags: -I"${includedir}"  -I/usr/include -I/usr/include/eigen3 -I/usr/include/python3.12
Libs: -L"${libdir}" -lns3.46.1-ai-default  -lns3.46.1-core-default -lprotobuf::libprotobuf -lstdc++_libbacktrace
Libs.private: -L"${libdir}" 
