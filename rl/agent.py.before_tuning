import csv
import os
import pickle

import gymnasium as gym
import ns3ai_gym_env
import numpy as np

TARGET = "wifi-ai-dcf"
SCENARIOS = range(1, 41)

ALPHA = 0.10
GAMMA = 0.95
EPSILON_START = 1.0
EPSILON_MIN = 0.05
EPSILON_DECAY = 0.90

MODEL_FILE = "rl/q_table.pkl"
DATA_DIR = "rl/data"
COMBINED_CSV = os.path.join(DATA_DIR, "all_training_data.csv")
RL_INTERVAL = 0.1

# Experimental safeguards: keep CW away from extreme backoff values.
# These are bounds on the observed CW value; validate with the C++ CW update.
MIN_CW = 7
MAX_CW = 127

# Bound extreme reward values while preserving negative feedback.
REWARD_MIN = -1.0
REWARD_MAX = 1.0


def cw_bin_for(cw):
    if cw <= 3:
        return 3
    if cw <= 7:
        return 7
    if cw <= 15:
        return 15
    if cw <= 31:
        return 31
    if cw <= 63:
        return 63
    if cw <= 127:
        return 127
    if cw <= 255:
        return 255
    return 1023


def latency_bin_for(info):
    try:
        latency = float(info.get("latencyMs", 0.0))
    except (TypeError, ValueError, AttributeError):
        latency = 0.0
    if latency < 1.0:
        return 0
    if latency < 5.0:
        return 1
    if latency < 10.0:
        return 2
    if latency < 25.0:
        return 3
    if latency < 50.0:
        return 4
    if latency < 100.0:
        return 5
    return 6


# IMPORTANT: this 8-element state representation matches evaluate.py.
def discretize_state(state, info=None):
    info = info or {}
    return (
        min(int(state[0]), 10),
        min(int(state[1]), 10),
        int(np.clip(state[2], -5, 5)),
        int(np.clip(state[3], -5, 5)),
        int(state[4] > 0),
        int(state[5] > 0),
        latency_bin_for(info),
        cw_bin_for(int(state[6])),
    )


# Start with a fresh table if the old table uses the incompatible 7-field state.
# Back up the old file rather than silently reusing incompatible Q-values.
os.makedirs(os.path.dirname(MODEL_FILE), exist_ok=True)
q_table = {}
if os.path.exists(MODEL_FILE):
    try:
        with open(MODEL_FILE, "rb") as f:
            old_table = pickle.load(f)
        if old_table and all(isinstance(k, tuple) and len(k) == 8 for k in old_table):
            q_table = old_table
            print(f"[LOAD] Compatible 8-feature Q-table: {len(q_table)} states")
        else:
            backup = MODEL_FILE + ".incompatible_backup"
            with open(backup, "wb") as f:
                pickle.dump(old_table, f)
            print(f"[WARNING] Old Q-table state format differs; backed up to {backup}")
            print("[INFO] Starting a fresh compatible Q-table.")
    except Exception as exc:
        print(f"[WARNING] Could not load old Q-table ({exc}); starting fresh.")
        
def get_q_values(state):
    if state not in q_table:
        q_table[state] = np.zeros(3, dtype=np.float32)
    return q_table[state]



def choose_action(state, epsilon, current_cw):
    # Exploration is retained, but actions that would push CW outside the
    # experimental bounds are masked. Action IDs: 0=decrease, 1=keep, 2=increase.
    allowed = [0, 1, 2]
    if current_cw <= MIN_CW:
        allowed.remove(0)
    if current_cw >= MAX_CW:
        allowed.remove(2)

    if np.random.random() < epsilon:
        return int(np.random.choice(allowed))

    q_values = get_q_values(state)
    # Random tie-breaking avoids np.argmax's persistent preference for action 0.
    best = max(float(q_values[a]) for a in allowed)
    best_actions = [a for a in allowed if np.isclose(float(q_values[a]), best)]
    return int(np.random.choice(best_actions))

CSV_HEADER = [
    "scenario", "run", "episode", "step", "simulation_time",
    "queueA", "queueB", "queueGrowthA", "queueGrowthB",
    "packetLoss", "macFailures", "currentCW",
    "action", "cwBefore", "cwAfter", "reward",
    "nextQueueA", "nextQueueB", "nextQueueGrowthA", "nextQueueGrowthB",
    "nextPacketLoss", "nextMacFailures", "nextCW",
    "epsilon", "qBefore", "qAfter"
]

os.makedirs(DATA_DIR, exist_ok=True)
epsilon = EPSILON_START
total_transitions = 0
total_scenarios_completed = 0

print("==================================================")
print(" WIFI AI DCF - BOUNDED-CW TABULAR Q-LEARNING")
print(f"Scenarios: 1-{len(SCENARIOS)} | RL interval: {RL_INTERVAL}s")
print(f"CW bounds: {MIN_CW}-{MAX_CW} | Reward clip: [{REWARD_MIN}, {REWARD_MAX}]")
print("State: queue, queue growth, loss flag, MAC failure flag, latency bin, CW bin")
print("==================================================")

with open(COMBINED_CSV, "w", newline="") as combined_file:
    combined_writer = csv.writer(combined_file)
    combined_writer.writerow(CSV_HEADER)

    for scenario in SCENARIOS:
        run_number = scenario
        csv_file_path = os.path.join(DATA_DIR, f"scenario{scenario:02d}_training.csv")
        print(f"\n[START] Scenario {scenario}/40, run={run_number}", flush=True)
        env = None
        with open(csv_file_path, "w", newline="") as scenario_file:
            scenario_writer = csv.writer(scenario_file)
            scenario_writer.writerow(CSV_HEADER)
            try:
                env = gym.make(
                    "ns3ai_gym_env/Ns3-v0",
                    targetName=TARGET,
                    ns3Path="./",
                    ns3Settings={"scenario": scenario, "run": run_number},
                    debug=False,
                )
                obs, info = env.reset()
                raw_state = np.asarray(obs, dtype=np.float32)
                state = discretize_state(raw_state, info)
                total_reward = 0.0
                steps = 0

                while True:
                    cw_before = int(raw_state[6])
                    action_value = choose_action(state, epsilon, cw_before)
                    action = np.asarray([action_value], dtype=np.int32)
                    next_obs, raw_reward, terminated, truncated, next_info = env.step(action)
                    next_raw_state = np.asarray(next_obs, dtype=np.float32)
                    next_state = discretize_state(next_raw_state, next_info)

                    # Clip extreme rewards but preserve negative feedback.
                    reward = float(np.clip(float(raw_reward), REWARD_MIN, REWARD_MAX))
                    cw_after = int(next_raw_state[6])

                    current_q = get_q_values(state)
                    next_q = get_q_values(next_state)
                    q_before = float(current_q[action_value])
                    target = reward + GAMMA * float(np.max(next_q))
                    current_q[action_value] += ALPHA * (target - current_q[action_value])
                    q_after = float(current_q[action_value])

                    row = [
                        scenario, run_number, 1, steps + 1,
                        f"{steps * RL_INTERVAL:.3f}",
                        raw_state[0], raw_state[1], raw_state[2], raw_state[3],
                        raw_state[4], raw_state[5], cw_before,
                        action_value, cw_before, cw_after, reward,
                        next_raw_state[0], next_raw_state[1], next_raw_state[2],
                        next_raw_state[3], next_raw_state[4], next_raw_state[5],
                        cw_after, epsilon, q_before, q_after
                    ]
                    scenario_writer.writerow(row)
                    combined_writer.writerow(row)
                    scenario_file.flush()
                    combined_file.flush()

                    state, raw_state, info = next_state, next_raw_state, next_info
                    total_reward += reward
                    steps += 1
                    total_transitions += 1
                    if terminated or truncated:
                        break

                epsilon = max(EPSILON_MIN, epsilon * EPSILON_DECAY)
                total_scenarios_completed += 1
                print(f"[DONE] Scenario {scenario}: steps={steps}, clipped_reward_sum={total_reward:.4f}, epsilon={epsilon:.4f}, Q-states={len(q_table)}")

                with open(MODEL_FILE, "wb") as f:
                    pickle.dump(q_table, f)
                print(f"[CHECKPOINT] Saved {MODEL_FILE}")
            finally:
                if env is not None:
                    env.close()

with open(MODEL_FILE, "wb") as f:
    pickle.dump(q_table, f)

print("\n==================================================")
print("TRAINING FINISHED")
print(f"Scenarios completed: {total_scenarios_completed}/40")
print(f"Transitions: {total_transitions}")
print(f"Q-states: {len(q_table)}")
print(f"Q-table: {MODEL_FILE}")
print(f"Combined CSV: {COMBINED_CSV}")
print("==================================================")
